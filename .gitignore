venv/
.venv/
env/
.local/
.vscode/
.pytest_cache/
.ipynb_checkpoints/
*.pyc
__pycache__/

# Datasets anywhere (every study downloads its own into <study>/data/)
data/
_archive/

# Record-tool run outputs (see standards/RECORDS.md §4); only harvested small files are committed
/outputs/
console.log

# Generic run logs
logs/

# --- studies/cifar100-port-audit: CIFAR-100 port of the authors' code -------------------------
studies/cifar100-port-audit/cifar100/pg_project_output/activations/
studies/cifar100-port-audit/cifar100/pg_project_output/affinity_matrices/
# Trailing /* (not /) so git still descends into the directory and the
# negation below can take effect; an excluded directory is never entered.
studies/cifar100-port-audit/cifar100/pg_project_output/pg_data/*
!studies/cifar100-port-audit/cifar100/pg_project_output/pg_data/pg1_summary.csv
studies/cifar100-port-audit/cifar100/pg_project_output/results/pruned_models/
studies/cifar100-port-audit/cifar100/pg_project_output/trained_models/
# Archived runs (see docs/cifar100-status.md): same rules as the live dirs above
studies/cifar100-port-audit/cifar100/pg_project_output/runs/*/pg_data/*
!studies/cifar100-port-audit/cifar100/pg_project_output/runs/*/pg_data/pg1_summary.csv
studies/cifar100-port-audit/cifar100/pg_project_output/runs/*/results/pruned_models/
studies/cifar100-port-audit/cifar100/pg_project_output/runs/*/trained_models/
studies/cifar100-port-audit/cifar100/pg_project_output/runs/*/activations/
cifar100_pg_gpu.zip

# --- studies/cifar10-repro: keep code, gate.json and figures; drop checkpoints and dumps -------
studies/cifar10-repro/outputs/**/*.pth
studies/cifar10-repro/outputs/**/*.pt
studies/cifar10-repro/outputs/**/*.npz
studies/cifar10-repro/outputs/**/*.npy

# --- studies/mnist-lenet-sanity: intermediate artefacts are regenerated in minutes -------------
studies/mnist-lenet-sanity/outputs/

# --- studies/bert-pg-transfer --------------------------------------------------------------------
studies/bert-pg-transfer/agnews/

